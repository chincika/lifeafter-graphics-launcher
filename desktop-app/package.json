{
  "name": "lifeafter-graphics-launcher",
  "version": "2.3.7",
  "description": "Windows 11 Fluent desktop launcher for LifeAfter graphics profiles",
  "main": "main.js",
  "author": "不与世俗纷争",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node history-store.test.js && node background-services.test.js && node game-installations-store.test.js && node runtime-assets.test.js && node update-service.test.js",
    "pack": "electron-builder --dir",
    "portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "org.lifeafter.graphicslauncher",
    "productName": "明日之后画质启动器",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "history-store.js",
      "lan-status-server.js",
      "monitor-service.js",
      "settings-store.js",
      "game-installations-store.js",
      "runtime-assets.js",
      "update-service.js",
      "frame-core-integrity.json",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/LifeAfterBackend.exe",
        "to": "backend/LifeAfterBackend.exe"
      },
      {
        "from": "backend/LifeAfterFrameCore.exe",
        "to": "backend/LifeAfterFrameCore.exe"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "win": {
      "icon": "renderer/assets/app-icon.png",
      "artifactName": "LifeAfter-Graphics-Launcher-${version}.${ext}",
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
